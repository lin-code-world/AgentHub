{
  "name": "agent-api-gateway",
  "version": "1.0.0",
  "description": "AgentApiGateway —— 反代网关：多渠道 AI 上游的反向代理与号池管理",
  "author": "沐晖",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:1420 && electron .\"",
    "dev:web": "vite",
    "web": "vite --open",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder",
    "electron:pack": "npm run build && electron-builder --dir",
    "gen:icon": "node tools/gen-icon.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "chokidar": "^3.6.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.6.2",
    "concurrently": "^8.2.2",
    "echarts": "^5.4.3",
    "electron": "^35.0.0",
    "electron-builder": "^24.13.3",
    "element-plus": "^2.14.5",
    "pinia": "^2.1.7",
    "prettier": "^3.9.10",
    "typescript": "~5.3.3",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^4.5.3",
    "vue": "^3.4.21",
    "vue-tsc": "^1.8.27",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.huidada1.agentapigateway",
    "productName": "AgentApiGateway",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronLanguages": [
      "zh-CN"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      },
      {
        "from": "build/tray.png",
        "to": "build/tray.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AgentApiGateway"
    }
  }
}
